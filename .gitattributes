# bundle/ 的文本文件一律用 LF。manifest 里的 bundle_blake3 按文件字节计算，
# Windows 检出时换成 CRLF 会让 octo check 盖出不同的戳（2026-10-06 合并时遇到过）。
bundle/*.splash text eol=lf
bundle/*.json text eol=lf
bundle/*.md text eol=lf
bundle/assets/*.svg text eol=lf
bundle/screenshots/*.png binary
# tools/win 的 shell 脚本在 WSL 里运行，Windows 检出时也必须保持 LF，否则 bash 会报 $'\r' 错误。
tools/win/*.sh text eol=lf
