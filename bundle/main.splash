            Label{text: "模拟定位（测试和演示用，重启后自动关闭）" draw_text.color: ink draw_text.text_style: theme.font_bold{font_size: 13}}
            sims := View{width: Fill height: Fit flow: Right spacing: 6
                on_render: || {
                    for x in SIMS {
                        if sim.kind == x.k { ChipOn{text: x.n on_click: || sim_set(x.k)} }
                        else { Chip{text: x.n on_click: || sim_set(x.k)} }
                    }
                }
            }
        }
        sense_status := Label{width: Fill text: "" draw_text.color: secondary draw_text.text_style.font_size: 12}
    }
    library := SolidView{visible: false width: Fill height: Fill flow: Down spacing: 10 padding: Inset{left: 14 right: 14 top: 12 bottom: 8} draw_bg.color: ground
        View{width: Fill height: Fit flow: Right align: Align{y: 0.5}
            Bar{text: "‹ 返回" on_click: || show("home")}
            Label{width: Fill text: "曲库" draw_text.color: ink draw_text.text_style: theme.font_bold{font_size: 20}}
            Small{text: "AI 补标签" on_click: || ai_tag()}
        }
        View{width: Fill height: Fit flow: Right spacing: 8 align: Align{y: 0.5}
            new_song := Field{empty_text: "歌名 - 歌手" on_return: |text| add_song()}
            Primary{text: "添加" on_click: || add_song()}
        }
        lib_status := Label{width: Fill text: "每首歌都可以打开歌曲卡 · 标签为人工粗标或 AI 推断" draw_text.color: secondary draw_text.text_style.font_size: 12}
        lib_list := ScrollYView{width: Fill height: Fill flow: Down spacing: 10 on_render: || {
            for i in library_order() {
                let s = songs[i]
                RoundedView{width: Fill height: Fit flow: Right padding: 16 spacing: 8 draw_bg.color: SC_CARD draw_bg.border_radius: 24.0
                    GestureView{width: Fill height: Fit flow: Down spacing: 6 on_tap: |x, y| sc_from_library(i)
                        ScText{width: Fill height: 44 text: song_title(i) + " ›"}
                        ScMuted{width: Fill text: tag_line(s)}
                        if has_story(i) { ScMuted{width: Fill text: "有故事"} }
                        if s.src == "user_ai" { ScMuted{text: "AI 推断标签"} }
                    }
                    if s.src != "seed" { Small{text: "删除" on_click: || remove_song(i)} }
                }
            }
        }}
    }
    song_card := SolidView{visible: false width: Fill height: Fill flow: Down padding: 16 spacing: 8 draw_bg.color: SC_GROUND
        View{width: Fill height: 50 flow: Right spacing: 8 align: Align{y: 0.5}
            ScButton{width: 64 text: "‹" on_click: || sc_return()}
            sc_heading := ScMuted{width: Fill text: ""}
        }
        sc_demo := Notice{visible: false width: Fill ScMuted{width: Fill text: "演示数据 · 含测试记录" draw_text.color: SC_WARNING}}
        sc_gesture := GestureView{width: Fill height: Fill flow: Down on_swipe: |dx, dy| sc_swipe(dx, dy)
            sc_front := View{width: Fill height: Fill flow: Down spacing: 14
                cover_tap := GestureView{width: Fill height: 350 on_tap: |x, y| sc_flip() on_swipe: |dx, dy| sc_swipe(dx, dy)
                    RoundedView{width: Fill height: Fill flow: Down padding: 16 spacing: 4 draw_bg.color: SC_CARD draw_bg.border_radius: 24.0
                        View{width: Fill height: 300 flow: Overlay align: Align{x: 0.5 y: 0.5}
                            sc_picture := View{visible: false width: 300 height: 300
                                sc_image := Image{width: 300 height: 300 fit: ImageFit.CropToFill}
                            }
                            sc_disc := RoundedView{width: 300 height: 300 align: Align{x: 0.5 y: 0.5} draw_bg.color: SC_RAISED draw_bg.border_radius: 150.0
                                RoundedView{width: 204 height: 204 align: Align{x: 0.5 y: 0.5} draw_bg.color: SC_BORDER draw_bg.border_radius: 102.0
                                    RoundedView{width: 96 height: 96 align: Align{x: 0.5 y: 0.5} draw_bg.color: SC_ACCENT draw_bg.border_radius: 48.0
                                        sc_letter := Label{text: "♪" draw_text.color: SC_GROUND draw_text.text_style: theme.font_bold{font_size: 28}}
                                    }
                                }
                            }
                        }
                        View{width: Fill height: Fit flow: Right
                            sc_cover_label := ScMuted{width: Fill text: ""}
                            sc_flip_label := ScMuted{text: "" draw_text.color: SC_ACCENT}
                        }
                    }
                }
                sc_title := Label{width: Fill text: "" draw_text.color: SC_INK draw_text.text_style: theme.font_bold{font_size: 28}}
                sc_artist := ScMuted{width: Fill text: ""}
                sc_context := ScMuted{visible: false width: Fill text: "" draw_text.text_style.font_size: 13}
            }
            sc_content := View{width: Fill height: Fill flow: Down on_render: || {
                let c = sc_data()
                ScrollYView{width: Fill height: Fill flow: Down spacing: 14
                    if sc_page == 1 {
                        ScTitle{text: "歌词"}
                        ScMuted{width: Fill text: "静态全文 · 不跟随播放进度"}
                        if sc_lyrics.trim() == "" {
                            ScText{width: Fill text: "还没有歌词"}
                            ScMuted{width: Fill text: "将歌词文本放入本机应用存储，再在歌曲卡内容中指定歌词文件。"}
                        }
                        for line in sc_lyric_lines() { ScText{width: Fill text: line} }
                    }
                    if sc_page == 2 {
                        ScTitle{text: "故事和档案"}
                        if c.facts.len() == 0 && c.reading == "" { ScText{width: Fill text: "还没有这首歌的故事"} }
                        if c.facts.len() > 0 {
                            ScMuted{text: "事实 · 每条附出处" draw_text.color: SC_INK}
                            for f in c.facts {
                                RoundedView{width: Fill height: Fit flow: Down spacing: 6 padding: 16 draw_bg.color: SC_CARD draw_bg.border_radius: 16.0
                                    ScText{width: Fill text: f.text}
                                    ScMuted{width: Fill text: "出处：" + f.src}
                                }
                            }
                        }
                        if c.reading != "" {
                            ScText{width: Fill text: "解读（AI 整理，可能不准）" draw_text.color: SC_INK}
                            ScMuted{width: Fill text: if c.by == "preset" "预制内容" else if c.by == "ai" "应用内生成" else "生成方式未注明"}
                            ScText{width: Fill text: c.reading}
                        }
                        if c.credits != "" || c.date != "" || c.where != "" || c.note != "" { ScTitle{text: "歌曲档案"} }
                        if c.credits != "" { ScText{width: Fill text: c.credits} }
                        if c.date != "" { ScMuted{width: Fill text: "首发：" + c.date} }
                        if c.where != "" { ScMuted{width: Fill text: "平台：" + c.where} }
                        if c.note != "" { ScMuted{width: Fill text: c.note} }
                    }
                    if sc_page == 3 {
                        let e = sc_enc()
                        ScTitle{text: "你和这首歌"}
                        if e.seen == nil && e.heard == nil && e.liked == nil {
                            ScText{width: Fill text: "你们还没有正式见过面"}
                        }
                        if e.seen != nil || e.heard != nil || e.liked != nil {
                            let moments = [{title: "初见" m: e.seen} {title: "第一次去听" m: e.heard} {title: "心动" m: e.liked}]
                            for row in moments {
                                RoundedView{width: Fill height: Fit flow: Down padding: 16 spacing: 8 draw_bg.color: SC_CARD draw_bg.border_radius: 16.0
                                    ScText{width: Fill text: row.title + "  ·  " + sc_date(row.m) draw_text.color: SC_INK}
                                    ScText{width: Fill text: sc_moment_text(row.m, row.title)}
                                    if row.m != nil && row.m.sim { Notice{ScMuted{width: Fill text: "测试数据" draw_text.color: SC_WARNING}} }
                                }
                            }
                            ScText{width: Fill text: "相遇统计" draw_text.color: SC_INK}
                            ScMuted{width: Fill text: sc_stats()}
                        }
                    }
                    View{width: Fill height: 12}
                }
            }}
        }
        sc_dots := View{width: Fill height: 44 flow: Right align: Align{x: 0.5 y: 0.5} on_render: || {
            for p in 4 {
                GestureView{width: 44 height: 44 align: Align{x: 0.5 y: 0.5} on_tap: |x, y| sc_turn(p)
                    RoundedView{width: if p == sc_page 20 else 8 height: 8 draw_bg.color: if p == sc_page SC_ACCENT else SC_BORDER draw_bg.border_radius: 4.0}
                }
            }
        }}
        sc_notice := ScMuted{width: Fill height: 20 text: "" align: Align{x: 0.5}}
        View{width: Fill height: 60 flow: Right spacing: 5 align: Align{y: 0.5}
            ScButton{width: Fill height: 56 text: "‹\n上一首" on_click: || sc_next(-1)}
            ScButton{width: Fill height: 56 text: "✕\n不喜欢" on_click: || sc_feedback(-1)}
            ScPrimary{width: 88 height: 56 text: "▶ 去听" on_click: || sc_play()}
            ScButton{width: Fill height: 56 text: "♥\n喜欢" draw_text.color: SC_ACCENT on_click: || sc_feedback(1)}
            ScButton{width: Fill height: 56 text: "›\n下一首" on_click: || sc_next(1)}
        }
        sc_count := ScMuted{width: Fill height: 24 text: "" align: Align{x: 0.5}}
    }

    player_pane := SolidView{visible: false width: Fill height: Fill flow: Down draw_bg.color: ground
        View{width: Fill height: Fit flow: Right align: Align{y: 0.5} spacing: 6 padding: Inset{left: 4 right: 12 top: 6 bottom: 6}
            Bar{text: "‹ 返回" on_click: || close_player()}
            player_title := Label{width: Fill text: "" draw_text.color: ink draw_text.text_style: theme.font_bold{font_size: 14}}
        }
        sources := View{width: Fill height: Fit flow: Right spacing: 6 padding: Inset{left: 12 right: 12 bottom: 6}
            on_render: || {
                for i s in SOURCES {
                    if source == i { ChipOn{text: s.n on_click: || pick_source(i)} }
                    else { Chip{text: s.n on_click: || pick_source(i)} }
                }
            }
        }
        player_url := Label{width: Fill padding: Inset{left: 14 right: 14} text: "" draw_text.color: secondary draw_text.text_style.font_size: 11}
        Label{width: Fill padding: Inset{left: 14 right: 14 top: 4 bottom: 6} text: "下方是应用内网页，在页面里点播放。若一直空白：当前平台（例如 Linux 桌面版）没有内置网页，请在手机或 macOS 上使用，或用上面的链接在浏览器打开。" draw_text.color: secondary draw_text.text_style.font_size: 11}
        player_fail := Label{width: Fill padding: Inset{left: 14 right: 14} text: "" draw_text.color: bad draw_text.text_style.font_size: 12}
        reader := WebReader{width: Fill height: Fill on_error: || ui.player_fail.set_text(ui.reader.error())}
    }
}
