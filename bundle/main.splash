fn key_of(s){ s.t + "|" + s.a }

// 读字段：缺失的字段直接访问会报错并中断整个处理函数（已实测），所以读旧数据一律用它
fn pick(o, key, dflt){
    if o == nil { return dflt }
    for k v in o { if k == key { return v } }
    dflt
}
fn join(list, sep){
    let text = ""
    for w in list { if text == "" { text = w } else { text = text + sep + w } }
    text
}

fn blank_fb(){ {g: 0 study: 0 work: 0 commute: 0 walk: 0 workout: 0 relax: 0 sleep: 0} }

// 反馈分按活动读写：用固定字段，不用 f[id] = v（运行时会追加重复键而不是覆盖）
fn fb_get(f, id){
    if id == "study" { return f.study }
    if id == "work" { return f.work }
    if id == "commute" { return f.commute }
    if id == "walk" { return f.walk }
    if id == "workout" { return f.workout }
    if id == "relax" { return f.relax }
    if id == "sleep" { return f.sleep }
    0
}
fn fb_set(f, id, v){
    if id == "g" { f.g = v }
    if id == "study" { f.study = v }
    if id == "work" { f.work = v }
    if id == "commute" { f.commute = v }
    if id == "walk" { f.walk = v }
    if id == "workout" { f.workout = v }
    if id == "relax" { f.relax = v }
    if id == "sleep" { f.sleep = v }
}
// 旧版数据可能缺 walk 等字段：逐键复制，缺的保持 0
fn fb_clean(f){
    let out = blank_fb()
    if f == nil { return out }
    for k v in f {
        if v >= -3 && v <= 3 { fb_set(out, k, v) }
    }
    out
}
fn fb_nonzero(f){
    f.g != 0 || f.study != 0 || f.work != 0 || f.commute != 0 || f.walk != 0 || f.workout != 0 || f.relax != 0 || f.sleep != 0
}

fn read_json(name){
    let path = DATA + name
    if !fs.exists(path) { return nil }
    let v = fs.read(path).parse_json()
    v
}
fn write_json(name, v){ fs.write(DATA + name, v.to_json()) }

// ---- 启动加载 ----
// 1. 每一步只读一个文件，读和分批处理各占自己的处理函数（start_timeout）：单次 64 ms 墙钟上限只摊到一次读写上。
//    数据在慢盘上（WSL 访问 /mnt/f 走 9P）时，一次读写就可能吃掉大半个 64 ms（③-补2，A/B 已证实）。
// 2. 分批：一次处理太多条会超过每个处理函数 20 万条指令的上限（500 条确认记录时实测超限）。
// 3. 看门狗：任何一步超时都会中断它所在的处理函数，后面的链就断了。看门狗每 BOOT_STALL_S 秒看一次，
//    一个周期没有进展就从断掉的那一步整步重试（每一步开头先清空自己要填的数据，重试不会重复）。
//    boot_gen 每次重试加 1，旧链上残留的回调发现代号不对就退出，避免同一步跑两遍。
let booted = false
let BOOT_STALL_S = 1.0
let boot_step = "dir"     // 正在做的一步，看门狗从这里重试
let boot_gen = 0
let boot_tick = 0         // 每有一点进展就加 1
let boot_seen = -1        // 看门狗上次看到的 boot_tick
let boot_tries = 0        // 当前这一步重试了几次（换下一步时清零）
let boot_retries = 0      // 整个启动一共重试了几次，启动完成后显示出来，方便测试核对
let boot_restored = false
fn boot_next(step){
    boot_step = step
    boot_tries = 0
    boot_tick = boot_tick + 1
    let gen = boot_gen
    start_timeout(0.01, || boot_run(gen, step))
}
// 读一个文件，下一个处理函数开始分批处理
fn boot_read(gen, name, size, each, next){
    let list = as_list(read_json(name))
    boot_tick = boot_tick + 1
    start_timeout(0.01, || boot_chunks(gen, list, 0, size, each, next))
}
fn boot_chunks(gen, list, start, size, each, next){
    if gen != boot_gen { return }
    let end = min(start + size, list.len())
    for i in end - start { each(list[start + i]) }
    boot_tick = boot_tick + 1
    if end < list.len() { start_timeout(0.01, || boot_chunks(gen, list, end, size, each, next)) }
    else { boot_next(next) }
}
fn boot_label(step){
    if step == "dir" { return "数据目录" }
    if step == "prefs" { return "偏好" }
    if step == "places" { return "地点" }
    if step == "library" { return "曲库" }
    if step == "feedback" { return "反馈" }
    if step == "labels" { return "确认记录" }
    if step == "encounters" { return "相遇记录" }
    if step == "cards" { return "歌曲卡" }
    if step == "card_history" { return "歌曲卡历史" }
    if step == "last" { return "上次的歌单" }
    "收尾"
}
fn boot_watch(){
    if booted { return }
    if boot_tick != boot_seen {
        boot_seen = boot_tick
        return
    }
    // 整整一个周期没有进展：链断了，整步重试，并把原因显示出来，而不是一直"正在加载…"
    boot_tries = boot_tries + 1
    boot_retries = boot_retries + 1
    boot_gen = boot_gen + 1
    plan_note = "正在加载…（读取" + boot_label(boot_step) + "超时，第 " + boot_tries + " 次重试）"
    if boot_tries >= 3 { plan_note = plan_note + "\n数据所在的磁盘可能太慢，会一直重试下去" }
    ui.plan.set_text(plan_note)
    let gen = boot_gen
    let step = boot_step
    start_timeout(0.01, || boot_run(gen, step))
}
fn as_list(v){
    if v == nil { return [] }
    v
}
fn load_lib_song(s){
    let t = pick(s, "t", "")
    if t != "" {
        songs.push({t: t a: pick(s, "a", "未知歌手") en: pick(s, "en", nil) vo: pick(s, "vo", nil)
            md: pick(s, "md", nil) lg: pick(s, "lg", nil) src: pick(s, "src", "user") fb: blank_fb()})
    }
}
let song_keys = []      // 与 songs 一一对应的 "歌名|歌手"，加载反馈时避免反复拼字符串
fn index_songs(){
    song_keys = []
    for s in songs { song_keys.push(key_of(s)) }
}
fn load_fb_row(row){
    let k = pick(row, "k", "")
    for j key in song_keys {
        if key == k { songs[j].fb = fb_clean(pick(row, "fb", nil)) }
    }
}
// 读文件里的一个时刻，转成字段齐全的对象。之后一律直接读字段（m.sim），
// 因为 pick() 对脚本里新建的对象无效：那种对象的键和字符串比较永远不相等（已实测）
fn enc_clean(m){
    if m == nil { return nil }
    {at: pick(m, "at", 0) slot: pick(m, "slot", "") weekend: pick(m, "weekend", false) act: pick(m, "act", "")
        place_kind: pick(m, "place_kind", "") motion: pick(m, "motion", "unknown") weather: pick(m, "weather", "")
        city: pick(m, "city", "") intent: pick(m, "intent", "") sim: pick(m, "sim", false) == true}
}
fn load_enc(x){
    let k = pick(x, "k", "")
    if k != "" {
        encounters.push({k: k seen: enc_clean(pick(x, "seen", nil)) heard: enc_clean(pick(x, "heard", nil)) liked: enc_clean(pick(x, "liked", nil))})
    }
}
fn load_label(x){
    let chosen = pick(x, "chosen", "")
    if act_by_id(chosen) != nil {
        labels.push({at: pick(x, "at", 0) day: pick(x, "day", "") slot: pick(x, "slot", "") place_kind: pick(x, "place_kind", "")
            motion: pick(x, "motion", "unknown") chosen: chosen top: pick(x, "top", []) how: pick(x, "how", "tap")})
    }
}
// 每一步一个处理函数；读了文件的步骤只读这一个文件。重试时整步重来，所以每步开头先清空自己要填的数据
fn boot_run(gen, step){
    if gen != boot_gen || booted { return }
    if step == "dir" {
        fs.mkdir(DATA)
        boot_next("prefs")
    } else if step == "prefs" {
        boot_prefs()
        boot_next("places")
    } else if step == "places" {
        boot_places()
        boot_next("library")
    } else if step == "library" {
        songs = []
        for s in SEED {
            songs.push({t: s.t a: s.a en: s.en vo: s.vo md: s.md lg: s.lg src: "seed" fb: blank_fb()})
        }
        boot_read(gen, "library.json", 30, |s| load_lib_song(s), "feedback")
    } else if step == "feedback" {
        // 套反馈是覆盖写（songs[j].fb = …），重试不会叠加
        index_songs()
        boot_read(gen, "feedback.json", 30, |row| load_fb_row(row), "labels")
    } else if step == "labels" {
        labels = []
        boot_read(gen, "labels.json", 50, |x| load_label(x), "encounters")
    } else if step == "encounters" {
        encounters = []
        // 每条要整理 3 个时刻、每个 11 个字段，比确认记录重，所以每批只读 20 条
        boot_read(gen, "encounters.json", 20, |x| load_enc(x), "cards")
    } else if step == "cards" {
        song_cards = []
        boot_read(gen, "cards.json", 5, |x| load_song_card(x), "card_history")
    } else if step == "card_history" {
        card_history = []
        boot_read(gen, "history.json", 10, |x| load_card_history(x), "last")
    } else if step == "last" {
        boot_last()
        boot_next("done")
    } else {
        boot_done()
    }
}
fn boot_prefs(){
    let p = read_json("prefs.json")
    if p != nil {
        let city = pick(p, "city", 0)
        if city >= 0 && city < CITIES.len() { prefs.city = city }
        prefs.act = pick(p, "act", "")
        prefs.act_until = pick(p, "act_until", 0)
        prefs.act_how = pick(p, "act_how", "manual")
        prefs.act_bucket = pick(p, "act_bucket", "")
        if act_by_id(prefs.act) == nil {
            prefs.act = ""
            prefs.act_until = 0
        }
        prefs.use_weather = pick(p, "use_weather", true)
        prefs.use_time = pick(p, "use_time", true)
        prefs.use_gps = pick(p, "use_gps", true)
    }
}
fn boot_places(){
    let pl = nil
    if fs.exists(PLACES_FILE) { pl = fs.read(PLACES_FILE).parse_json() }
    places = []
    for x in as_list(pl) {
        let kind = pick(x, "kind", "")
        if kind_name(kind) != "" {
            places.push({id: pick(x, "id", kind) kind: kind name: kind_name(kind) lat: pick(x, "lat", 0.0) lon: pick(x, "lon", 0.0)})
        }
    }
}
// 恢复上次歌单
fn boot_last(){
    playlist = []
    boot_restored = false
    let last = read_json("last.json")
    if last != nil {
        let keys = pick(last, "keys", [])
        let whys = pick(last, "whys", [])
        playlist_intent = pick(last, "intent", "")
        for i k in keys {
            for j key in song_keys {
                if key == k && i < whys.len() { playlist.push({i: j why: whys[i]}) }
            }
        }
        playlist_act = pick(last, "act", "")
        playlist_slot = pick(last, "slot", "")
        let at = pick(last, "at", 0)
        if playlist_slot == "" && at > 0 { playlist_slot = slot_name(sc_local_time(at).hour) }
    }
    boot_restored = playlist.len() > 0
}
// 启动完成。天气和定位各自放到后面的处理函数里，它们出问题也不影响启动
fn boot_done(){
    if boot_restored { plan_note = "上次的歌单（重启后恢复）" }
    else { plan_note = "" }
    if boot_retries > 0 {
        if plan_note != "" { plan_note = plan_note + "\n" }
        plan_note = plan_note + "（启动时读写超时，重试了 " + boot_retries + " 次）"
    }
    booted = true
    if boot_restored { flow_activity = playlist_act ui.intent.set_text(playlist_intent) }
    home_step(if boot_restored 3 else 1)
    sync_home()
    ui.cities.render()
    start_timeout(0.01, || fetch_weather())
    start_timeout(0.02, || gps_poll())
}

fn save_prefs(){ write_json("prefs.json", prefs) }
// 地点放在存储根目录，不放 accounts/device/：应用助手只能读后者，这样坐标不会经助手发给 AI
let PLACES_FILE = "places.json"
fn save_places(){ fs.write(PLACES_FILE, places.to_json()) }
// 会增长的文件：启动没读完之前不写，否则慢盘上一边重试读、一边被只有一半数据的内存覆盖
fn save_labels(){ if booted { write_json("labels.json", labels) } }
fn save_library(){
    if !booted { return }
    let out = []
    for s in songs { if s.src != "seed" { out.push({t: s.t a: s.a en: s.en vo: s.vo md: s.md lg: s.lg src: s.src}) } }
    write_json("library.json", out)
}
fn save_feedback(){
    if !booted { return }
    let out = []
    for s in songs {
        if fb_nonzero(s.fb) { out.push({k: key_of(s) fb: s.fb}) }
    }
    write_json("feedback.json", out)
}
fn save_last(){
    let keys = []
    let whys = []
    for p in playlist {
        keys.push(key_of(songs[p.i]))
        whys.push(p.why)
    }
    write_json("last.json", {keys: keys whys: whys act: playlist_act slot: playlist_slot intent: playlist_intent at: time_now()})
}
fn save_encounters(){ if booted { write_json("encounters.json", encounters) } }

// ---- 时间 ----
fn local_parts(){
    let t = time_now() + weather.offset
    let day = floor(t / 86400)
    let sec = t - day * 86400
    let hour = floor(sec / 3600)
    let minute = floor((sec - hour * 3600) / 60)
    let wd = day + 4 - floor((day + 4) / 7) * 7   // 1970-01-01 是周四；0 = 周日
    {hour: hour minute: minute weekday: wd}
}
fn slot_name(h){
    if h < 5 { return "深夜" }
    if h < 9 { return "早晨" }
    if h < 12 { return "上午" }
    if h < 14 { return "中午" }
    if h < 17 { return "下午" }
    if h < 19 { return "傍晚" }
    if h < 23 { return "晚上" }
    "深夜"
}
fn slot_act(h){
    if h < 6 { return "sleep" }
    if h < 9 { return "commute" }
    if h < 12 { return "work" }
    if h < 14 { return "relax" }
    if h < 17 { return "work" }
    if h < 19 { return "commute" }
    if h < 23 { return "relax" }
    "sleep"
}
fn day_word(p){
    if p.weekday == 0 || p.weekday == 6 { return "周末" }
    "工作日"
}
fn act_by_id(id){
    for a in ACTS { if a.id == id { return a } }
    nil
}
fn act_name(id){
    let a = act_by_id(id)
    if a == nil { return "未知" }
    a.n
}
fn manual_left(){
    if prefs.act == "" { return 0 }
    let left = prefs.act_until - time_now()
    if left <= 0 { return 0 }
    left
}

// ---- 天气 ----
fn weather_usable(){ prefs.use_weather && weather.state == "ok" && time_now() - weather.at < 3600 }
fn weather_word(code){
    if code == 0 { return "晴" }
    if code <= 3 { return "多云" }
    if code <= 48 { return "雾" }
    if code <= 67 { return "雨" }
    if code <= 77 { return "雪" }
    if code <= 82 { return "阵雨" }
    if code <= 86 { return "阵雪" }
    "雷雨"
}
fn weather_mood(){
    if !weather_usable() { return "" }
    let c = weather.code
    if c >= 51 && c <= 67 { return "平静" }
    if c >= 80 && c <= 82 { return "平静" }
    if weather.temp <= 5 { return "温暖" }
    if c == 0 && weather.temp >= 15 { return "欢快" }
    ""
}
// coords: "gps" 或 "city"；坐标只保留两位小数（约 1 km）再发出去
fn fetch_weather_at(lat, lon, coords){
    weather.state = "loading"
    weather.coords = coords
    wx_pos = {lat: lat lon: lon at: time_now()}
    wx_seq = wx_seq + 1
    let seq = wx_seq
    let la = round(lat * 100) / 100
    let lo = round(lon * 100) / 100
    let url = "https://api.open-meteo.com/v1/forecast?latitude=" + la + "&longitude=" + lo + "&current=temperature_2m,weather_code&timezone=auto"
    net.http_request(net.HttpRequest{url: url method: net.HttpMethod.GET headers: {"User-Agent": "ContextDJ/0.3"}}) do net.HttpEvents{
        on_response: |res| got_weather(res, coords, seq)
        on_error: |_err| weather_failed(seq)
    }
}
fn fetch_weather(){
    let c = CITIES[prefs.city]
    fetch_weather_at(c.lat, c.lon, "city")
}
fn got_weather(res, coords, seq){
    if seq != wx_seq { return }
    if res.status_code >= 400 { weather_failed(seq) return }
    let d = res.body.to_string().parse_json()
    if d == nil { weather_failed(seq) return }
    let cur = pick(d, "current", nil)
    if cur == nil { weather_failed(seq) return }
    let t = pick(cur, "temperature_2m", nil)
    let wc = pick(cur, "weather_code", nil)
    if t == nil || wc == nil { weather_failed(seq) return }
    if !(t >= -90) || !(wc >= 0) { weather_failed(seq) return }
    weather = {state: "ok" temp: t code: wc text: weather_word(wc) offset: pick(d, "utc_offset_seconds", 28800) at: time_now() coords: coords}
    refresh_views()
}
fn weather_failed(seq){
    if seq != wx_seq { return }
    weather.state = "fail"
    refresh_views()
}
// 有定位时按定位查：第一次、移动超过 5 km、或超过 30 分钟
fn maybe_refresh_weather(){
    if !prefs.use_gps || fixes.len() == 0 { return }
    let f = fixes[fixes.len() - 1]
    if wx_pos == nil || weather.coords != "gps" {
        fetch_weather_at(f.lat, f.lon, "gps")
        return
    }
    if dist_m(wx_pos.lat, wx_pos.lon, f.lat, f.lon) > 5000 || time_now() - wx_pos.at > 1800 {
        fetch_weather_at(f.lat, f.lon, "gps")
    }
}

// ---- S 感知（PLAN 2.3）----
fn dist_m(lat1, lon1, lat2, lon2){
    let dy = (lat2 - lat1) * 111320.0
    let dx = (lon2 - lon1) * 111320.0 * cos(lat1 * PI / 180.0)
    sqrt(dx * dx + dy * dy)
}
fn kind_name(kind){
    for x in PLACE_KINDS { if x.k == kind { return x.n } }
    ""
}
fn motion_name(st){
    if st == "still" { return "静止" }
    if st == "walk" { return "步行" }
    if st == "run_bike" { return "跑步或骑行" }
    if st == "vehicle" { return "乘车" }
    "未知"
}
fn sim_speed(){
    for x in SIMS { if x.k == sim.kind { return x.v } }
    0.0
}
// 模拟一个定位点：沿正北前进，叠加 ±8 m 抖动，精度 10 m
fn sim_next(){
    let now = time_now()
    let dt = now - sim.t
    sim.t = now
    sim.lat = sim.lat + sim_speed() * dt / 111320.0
    let jy = (random() - 0.5) * 16.0
    let jx = (random() - 0.5) * 16.0
    {t: now lat: sim.lat + jy / 111320.0 lon: sim.lon + jx / (111320.0 * cos(sim.lat * PI / 180.0)) acc: 10.0}
}
// 取一个定位点；拿不到时返回 nil，原因写在 gps_note
let gps_note = "还没有定位"
fn read_fix(){
    if sim.kind != "off" { return sim_next() }
    if !prefs.use_gps { gps_note = "定位已关闭" return nil }
    if sys.gps("ok") < 1 { gps_note = "没有定位（未授权或还没有信号）" return nil }
    let acc = sys.gps("acc")
    if acc < 0 || acc > ACC_MAX_M { gps_note = "定位精度太差（±" + round(acc) + " m）" return nil }
    gps_note = ""
    {t: time_now() lat: sys.gps("lat") lon: sys.gps("lon") acc: acc}
}
fn median_acc(list){
    let n = list.len()
    let want = floor(n / 2)
    for x in list {
        let less = 0
        let equal = 0
        for y in list {
            if y.acc < x.acc { less = less + 1 }
            if y.acc == x.acc { equal = equal + 1 }
        }
        if less <= want && want < less + equal { return x.acc }
    }
    0.0
}
fn estimate_speed(){
    let now = time_now()
    let win = []
    for x in fixes { if now - x.t <= WIN_S { win.push(x) } }
    if win.len() < MIN_FIXES { return {valid: false n: win.len() speed: 0.0 acc: 0.0} }
    let a = win[0]
    let b = win[win.len() - 1]
    let span = b.t - a.t
    if span < 30 { return {valid: false n: win.len() speed: 0.0 acc: 0.0} }
    let accm = median_acc(win)
    let d = dist_m(a.lat, a.lon, b.lat, b.lon)
    let speed = 0.0
    if d >= max(STILL_FLOOR_M, 1.5 * accm) { speed = d / span }
    {valid: true n: win.len() speed: speed acc: accm}
}
fn classify(v){
    if v < 0.5 { return "still" }
    if v < 2.2 { return "walk" }
    if v < 7.0 { return "run_bike" }
    "vehicle"
}
fn update_motion(){
    let src = "gps"
    if sim.kind != "off" { src = "sim" }
    if fixes.len() == 0 {
        motion = {state: "unknown" speed: 0.0 conf: 0.0 n: 0 source: "none" note: gps_note}
        pending = {state: "" count: 0}
        return
    }
    let e = estimate_speed()
    if !e.valid {
        motion.note = "定位点还不够（" + e.n + "/" + MIN_FIXES + "，需要约 40 秒）"
        return
    }
    let st = classify(e.speed)
    if pending.state == st { pending.count = pending.count + 1 }
    else { pending = {state: st count: 1} }
    let conf = min(1.0, e.n / 6.0)
    if e.acc > 20 { conf = conf * 0.7 }
    let stale = false
    if same_since > 0 && time_now() - same_since >= UNCHANGED_S {
        conf = conf * 0.5
        stale = true
    }
    let note = "近 1 分钟约 " + round(e.speed * 10) / 10 + " m/s，" + e.n + " 个点，精度约 ±" + round(e.acc) + " m"
    if stale { note = note + "；位置 5 分钟没变（可能是静止，也可能是信号没更新）" }
    if motion.state == "unknown" || motion.state == st || pending.count >= HOLD_N {
        motion = {state: st speed: e.speed conf: conf n: e.n source: src note: note}
    } else {
        motion.note = note + "；可能变成「" + motion_name(st) + "」，再确认一次"
    }
}
fn update_here(){
    let list = places
    if sim.kind != "off" { list = sim_places }
    here = {place: nil dist: -1}
    if fixes.len() == 0 { return }
    let f = fixes[fixes.len() - 1]
    let best = nil
    let bd = 1000000000.0
    for p in list {
        let d = dist_m(f.lat, f.lon, p.lat, p.lon)
        if d < bd {
            bd = d
            best = p
        }
    }
    if best != nil && bd <= PLACE_R_M { here = {place: best dist: bd} }
}
fn gps_poll(){
    if !booted { return }
    let f = read_fix()
    let now = time_now()
    if f != nil {
        if fixes.len() > 0 {
            let prev = fixes[fixes.len() - 1]
            if prev.lat == f.lat && prev.lon == f.lon {
                if same_since == 0 { same_since = prev.t }
            } else { same_since = 0 }
        }
        fixes.push(f)
    }
    let kept = []
    for x in fixes { if now - x.t <= FIX_KEEP_S { kept.push(x) } }
    fixes = kept
    update_motion()
    update_here()
    maybe_refresh_weather()
    refresh_views()
}
fn mark_place(kind){
    if fixes.len() == 0 { ui.sense_status.set_text("还没有定位，标记不了地点") return }
    let f = fixes[fixes.len() - 1]
    let item = {id: kind kind: kind name: kind_name(kind) lat: f.lat lon: f.lon}
    if sim.kind != "off" {
        let kept = []
        for p in sim_places { if p.kind != kind { kept.push(p) } }
        kept.push(item)
        sim_places = kept
        ui.sense_status.set_text("已在模拟位置标记「" + item.name + "」（只在模拟模式里有效，不保存）")
    } else {
        let kept = []
        for p in places { if p.kind != kind { kept.push(p) } }
        kept.push(item)
        places = kept
        save_places()
        ui.sense_status.set_text("已把当前位置标记为「" + item.name + "」（只存在本机）")
    }
    update_here()
    refresh_views()
}
fn remove_place(kind){
    let kept = []
    if sim.kind != "off" {
        for p in sim_places { if p.kind != kind { kept.push(p) } }
        sim_places = kept
    } else {
        for p in places { if p.kind != kind { kept.push(p) } }
        places = kept
        save_places()
    }
    ui.sense_status.set_text("已删除「" + kind_name(kind) + "」")
    update_here()
    refresh_views()
}
fn sim_set(kind){
    let was = sim.kind
    if kind == "off" {
        sim = {kind: "off" lat: 0.0 lon: 0.0 t: 0}
        sim_places = []
    } else {
        if was == "off" {
            let lat = 39.9042
            let lon = 116.4074
            if sys.gps("ok") >= 1 {
                lat = sys.gps("lat")
                lon = sys.gps("lon")
            }
            sim = {kind: kind lat: lat lon: lon t: time_now()}
        } else {
            sim.kind = kind
        }
    }
    if was == "off" || kind == "off" {
        fixes = []
        same_since = 0
        motion = {state: "unknown" speed: 0.0 conf: 0.0 n: 0 source: "none" note: "重新开始采样"}
        pending = {state: "" count: 0}
    }
    gps_poll()
}

// ---- C 情境融合（PLAN 2.4）----
fn act_result(id, src, conf, why){ {id: id source: src conf: conf why: why} }
// 不看手动和原话、只看传感器和时段的规则推断（PLAN 2.4 的优先级 3–8），同时作为规律统计的先验
fn infer_rules(){
    let p = local_parts()
    let rush = p.weekday >= 1 && p.weekday <= 5 && ((p.hour >= 7 && p.hour < 9) || (p.hour >= 17 && p.hour < 19))
    let m = motion
    let mline = "GPS：" + motion_name(m.state) + "，约 " + round(m.speed * 10) / 10 + " m/s"
    if m.source == "sim" { mline = "模拟定位：" + motion_name(m.state) + "，约 " + round(m.speed * 10) / 10 + " m/s" }
    if m.state == "still" && here.place != nil {
        let k = here.place.kind
        let w = ["位置：距「" + here.place.name + "」" + round(here.dist) + " m，静止"]
        if k == "gym" { return act_result("workout", "place", 0.8, w) }
        if k == "school" { return act_result("study", "place", 0.8, w) }
        if k == "work" { return act_result("work", "place", 0.8, w) }
        if p.hour >= 23 || p.hour < 6 { return act_result("sleep", "place", 0.8, w) }
        return act_result("relax", "place", 0.8, w)
    }
    if m.state == "vehicle" { return act_result("commute", "motion", 0.75 * m.conf, [mline + " → 乘车"]) }
    if m.state == "run_bike" {
        let at_gym = here.place != nil && here.place.kind == "gym"
        if rush && !at_gym { return act_result("commute", "motion", 0.6 * m.conf, [mline, "工作日通勤时段 → 通勤"]) }
        return act_result("workout", "motion", 0.6 * m.conf, [mline + " → 运动"])
    }
    if m.state == "walk" {
        if rush { return act_result("commute", "motion", 0.65 * m.conf, [mline, "工作日通勤时段 → 通勤"]) }
        return act_result("walk", "motion", 0.65 * m.conf, [mline + " → 散步"])
    }
    if prefs.use_time {
        let w = ["时段：" + day_word(p) + slot_name(p.hour)]
        if m.state == "still" { w.push(mline) }
        return act_result(slot_act(p.hour), "time", 0.35, w)
    }
    act_result("", "none", 0.0, ["没有可用的情境信号"])
}

// ---- 规律统计：候选活动排序（PLAN 9.4）----
fn day_type(p){
    if p.weekday == 0 || p.weekday == 6 { return "weekend" }
    "weekday"
}
fn cur_bucket(){
    let p = local_parts()
    let pk = ""
    if here.place != nil { pk = here.place.kind }
    {day: day_type(p) slot: slot_name(p.hour) place: pk motion: motion.state}
}
fn bucket_key(b){ b.day + "|" + b.slot + "|" + b.place + "|" + b.motion }
// 每个时段里常见的「第二猜测」，用来让冷启动时的第 2、3 个候选有意义
fn slot_alts(h){
    if h < 6 { return ["sleep" "relax"] }
    if h < 9 { return ["commute" "workout"] }
    if h < 12 { return ["work" "study"] }
    if h < 14 { return ["relax" "walk"] }
    if h < 17 { return ["work" "study"] }
    if h < 19 { return ["commute" "workout"] }
    if h < 23 { return ["relax" "study"] }
    ["sleep" "relax"]
}
// 先验：规则推断的活动 0.55；本时段的常见活动里、和它不同的平分 0.15；剩下 0.30 七个活动平分（合计为 1）
fn prior_of(id, r){
    if r.id == "" { return 1.0 / ACTS.len() }
    let pr = 0.30 / ACTS.len()
    if id == r.id { pr = pr + 0.55 }
    let alts = []
    for a in slot_alts(local_parts().hour) { if a != r.id { alts.push(a) } }
    if alts.len() == 0 { alts = ["relax"] }
    for a in alts { if a == id { pr = pr + 0.15 / alts.len() } }
    pr
}
// P(a|b) = (n(b,a) + ALPHA·prior(a|b)) / (n(b) + ALPHA)；完整桶不足 3 条时回退到 (日类型, 时段)
fn rank_acts(r){
    let b = cur_bucket()
    let cnt = blank_fb()
    let n = 0
    for l in labels {
        if l.day == b.day && l.slot == b.slot && l.place_kind == b.place && l.motion == b.motion {
            fb_set(cnt, l.chosen, fb_get(cnt, l.chosen) + 1)
            n = n + 1
        }
    }
    let level = "full"
    if n < 3 {
        cnt = blank_fb()
        n = 0
        for l in labels {
            if l.day == b.day && l.slot == b.slot {
                fb_set(cnt, l.chosen, fb_get(cnt, l.chosen) + 1)
                n = n + 1
            }
        }
        level = "coarse"
    }
    let rest = []
    for a in ACTS {
        let pr = prior_of(a.id, r)
        let k = fb_get(cnt, a.id)
        rest.push({id: a.id k: k p: (k + ALPHA * pr) / (n + ALPHA)})
    }
    let sorted = []
    for t in ACTS.len() {
        let bi = 0
        let bv = -1.0
        for j x in rest {
            if x.p > bv {
                bv = x.p
                bi = j
            }
        }
        sorted.push(rest[bi])
        rest[bi].p = -2.0
    }
    // 上面把 p 改成了 -2 作为「已选」标记，这里按原公式重算一次概率
    let out = []
    for x in sorted {
        let pr = prior_of(x.id, r)
        out.push({id: x.id k: x.k p: (x.k + ALPHA * pr) / (n + ALPHA)})
    }
    {list: out n: n level: level bucket: b}
}
fn infer_activity(it){
    // 先算规律排序：候选卡在手动选择期间也要显示最新的概率
    let r = infer_rules()
    let rk = rank_acts(r)
    last_rank = rk
    if manual_left() > 0 {
        let verb = "手动选了"
        if prefs.act_how == "tap" { verb = "确认了" }
        return act_result(prefs.act, "manual", 1.0, ["你" + verb + "「" + act_name(prefs.act) + "」，还剩 " + ceil(manual_left() / 60) + " 分钟"])
    }
    if it != nil && it.act != "" {
        return act_result(it.act, "intent", 0.9, ["你说了「" + it.act_word + "」"])
    }
    if session_act != nil && time_now() - session_act.at < SESSION_S && session_act.bucket == bucket_key(rk.bucket) {
        let w = []
        for x in session_act.why { w.push(x) }
        w.push("沿用刚才歌单的判断（" + ceil((SESSION_S - (time_now() - session_act.at)) / 60) + " 分钟内有效）")
        return act_result(session_act.id, session_act.source, session_act.conf, w)
    }
    let top = rk.list[0]
    if rk.n > 0 {
        let why = []
        for w in r.why { why.push(w) }
        let span_word = "同一时段、地点和移动状态"
        if rk.level == "coarse" { span_word = "同一时段" }
        if top.k == 0 {
            why.push("规律：" + span_word + "下你确认过 " + rk.n + " 次，但还没有一致的选择，暂按规则推测")
            return act_result(top.id, r.source, top.p, why)
        }
        why.push("规律：" + span_word + "下你确认过 " + rk.n + " 次，其中「" + act_name(top.id) + "」" + top.k + " 次")
        return act_result(top.id, "routine", top.p, why)
    }
    r
}
// 同一次选歌流程中，回到第①步改选会替换本次确认；撤销恢复原列表。
let flow_labels_before = nil
let flow_activity = ""
fn undo_flow_label(){
    if flow_labels_before != nil {
        labels = flow_labels_before
        flow_labels_before = nil
        start_timeout(0.01, || save_labels())
    }
}
fn confirm_act(id, how){
    if !booted || busy { return }
    if flow_labels_before != nil && prefs.act == id && manual_left() > 0 {
        undo_flow_label()
        prefs.act = ""
        prefs.act_until = 0
        session_act = nil
        flow_activity = ""
        save_prefs()
        refresh_views()
        return
    }
    if flow_labels_before == nil { flow_labels_before = labels }
    let b = cur_bucket()
    let top = []
    if last_rank != nil { for k in 3 { if k < last_rank.list.len() { top.push(last_rank.list[k].id) } } }
    // 和 add_label 一样：同一情境桶 30 分钟内重复确认同一个活动只算一次
    //（例如「从头再选一次」后又点了同一个活动），用新记录顶替旧的那条，避免放大统计
    let n_before = flow_labels_before.len()
    let dup = false
    if n_before > 0 {
        let l = flow_labels_before[n_before - 1]
        if l.chosen == id && l.day == b.day && l.slot == b.slot && l.place_kind == b.place && l.motion == b.motion {
            if time_now() - l.at < 1800 { dup = true }
        }
    }
    let next = []
    let start = max(0, n_before - LABEL_MAX + 1)
    let stop = n_before
    if dup { stop = n_before - 1 }
    for j x in flow_labels_before { if j >= start && j < stop { next.push(x) } }
    next.push({at: time_now() day: b.day slot: b.slot place_kind: b.place motion: b.motion chosen: id top: top how: how})
    labels = next
    prefs.act = id
    prefs.act_until = time_now() + ACT_TTL
    prefs.act_how = how
    prefs.act_bucket = bucket_key(b)
    flow_activity = id
    save_prefs()
    start_timeout(0.01, || save_labels())
    refresh_views()
    home_step(2)
}
fn flow_uncertain(){
    if !booted || busy { return }
    undo_flow_label()
    prefs.act = ""
    prefs.act_until = 0
    session_act = nil
    save_prefs()
    flow_activity = infer_activity(nil).id
    refresh_views()
    home_step(2)
}
fn add_label(b, id, top, how){
    // 同一情境桶里 30 分钟内重复确认同一个活动，只算一次（避免反复点击放大统计）
    if labels.len() > 0 {
        let l = labels[labels.len() - 1]
        if l.chosen == id && l.day == b.day && l.slot == b.slot && l.place_kind == b.place && l.motion == b.motion && time_now() - l.at < 1800 {
            l.at = time_now()
            start_timeout(0.01, || save_labels())
            return
        }
    }
    let next = []
    let start = 0
    if labels.len() >= LABEL_MAX { start = labels.len() - LABEL_MAX + 1 }
    for j x in labels { if j >= start { next.push(x) } }
    next.push({at: time_now() day: b.day slot: b.slot place_kind: b.place motion: b.motion chosen: id top: top how: how})
    labels = next
    // 选歌的处理函数里不直接写文件（一个处理函数最多一次读写，见 AGENTS.md）
    start_timeout(0.01, || save_labels())
}
fn toggle_all_acts(){
    show_all_acts = !show_all_acts
    ui.cands.render()
}
fn pct(p){ "" + round(p * 100) + "%" }
fn cand_top3(){
    let out = []
    if last_rank == nil { return out }
    for k in 3 { if k < last_rank.list.len() { out.push(last_rank.list[k]) } }
    out
}
// 候选卡的标题：要不要主动请你确认
fn cand_title(){
    if manual_left() > 0 {
        let verb = "已手动选择"
        if prefs.act_how == "tap" { verb = "已确认" }
        if flow_labels_before != nil { return verb + "：" + act_name(prefs.act) + "（再点同一活动可撤销本次确认）" }
        return verb + "：" + act_name(prefs.act) + "（可重新选择）"
    }
    if last_rank == nil { return "① 你现在在做什么？" }
    let top = last_rank.list[0]
    if top.p < ASK_P || last_rank.n == 0 {
        return "① 你现在在做什么？点一下确认，我会越来越懂你"
    }
    "① 按你的规律，你多半在" + act_name(top.id) + "（" + pct(top.p) + "）；不对就点下面改"
}
fn build_ctx(it){
    let p = local_parts()
    {at: time_now() hour: p.hour minute: p.minute weekday: p.weekday slot: slot_name(p.hour)
        weekend: p.weekday == 0 || p.weekday == 6
        weather: weather motion: motion here: here activity: infer_activity(it)}
}
fn source_word(src){
    if src == "manual" {
        if prefs.act_how == "tap" { return "你确认的" }
        return "手动"
    }
    if src == "intent" { return "你说的" }
    if src == "ai" { return "AI 推断" }
    if src == "place" { return "地点推断" }
    if src == "motion" { return "移动推断" }
    if src == "time" { return "时段推测" }
    if src == "routine" { return "规律推断" }
    "无"
}
fn act_line(a){
    if a.id == "" { return "未知 · 不参与" }
    act_name(a.id) + " · " + source_word(a.source) + " · 可信度 " + round(a.conf * 100) / 100
}
fn here_text(){
    if here.place == nil {
        if fixes.len() == 0 { return "未知" }
        return "不在已标记的地点"
    }
    "「" + here.place.name + "」附近 " + round(here.dist) + " m"
}

// ---- 意图：本地能理解的部分（AI 不可用时也有效） ----
fn has(text, words){
    for w in words { if text.search(w) >= 0 { return true } }
    false
}
fn first_hit(text, words){
    for w in words { if text.search(w) >= 0 { return w } }
    ""
}
// 情境词（PLAN 2.5）：按顺序匹配，第一个命中的生效；「上班路上」要先于「上班」
let ACT_WORDS = [
    {id: "commute" w: ["上班路上" "下班路上" "地铁" "公交" "开车" "打车" "通勤"]}
    {id: "workout" w: ["跑步" "健身" "撸铁" "骑车" "锻炼"]}
    {id: "walk" w: ["散步" "遛弯" "溜达"]}
    {id: "sleep" w: ["睡觉" "失眠" "助眠" "入睡"]}
    {id: "study" w: ["学习" "复习" "写作业" "刷题" "看书" "背单词"]}
    {id: "work" w: ["上班" "开会" "写代码" "加班" "干活"]}
    {id: "relax" w: ["休息" "放空" "躺着" "发呆"]}
]
fn parse_intent(raw){
    let x = ("" + raw).trim()
    let it = {instr: 0 energy: 0.0 mood: "" lang: "" fresh: false words: [] act: "" act_word: ""}
    for g in ACT_WORDS {
        if it.act == "" {
            let w = first_hit(x, g.w)
            if w != "" {
                it.act = g.id
                it.act_word = w
                it.words.push("情境：" + act_name(g.id))
            }
        }
    }
    // 先判断「要人声」，再让「不要人声」覆盖它（后者包含前者）
    let vocal_word = ""
    if has(x, ["要人声" "想听唱" "有歌词"]) {
        it.instr = -1
        vocal_word = "要人声"
    }
    if has(x, ["纯音乐" "不要人声" "无人声" "别唱" "没有歌词"]) {
        it.instr = 1
        vocal_word = "偏纯音乐"
    }
    if vocal_word != "" { it.words.push(vocal_word) }
    if has(x, ["嗨" "燃" "动感" "提神" "节奏快" "带劲" "有劲" "劲爆" "打鸡血" "来劲"]) {
        it.energy = 1.3
        it.words.push("能量高一点")
    }
    if has(x, ["安静" "舒缓" "柔和" "轻一点" "慢一点" "助眠" "别太吵" "放空"]) {
        it.energy = -1.2
        it.words.push("能量低一点")
    }
    if has(x, ["伤感" "难过" "丧" "emo" "失恋"]) {
        it.mood = "伤感"
    }
    if has(x, ["开心" "快乐" "高兴" "欢快"]) {
        it.mood = "欢快"
    }
    if has(x, ["怀旧" "回忆" "小时候" "青春"]) {
        it.mood = "怀旧"
    }
    if has(x, ["专注" "写代码" "看书" "复习" "刷题" "论文"]) {
        it.mood = "专注"
    }
    if has(x, ["温暖" "治愈" "暖" "甜"]) {
        it.mood = "温暖"
    }
    if has(x, ["励志" "振奋" "冲" "加油"]) {
        it.mood = "振奋"
    }
    if it.mood != "" { it.words.push("情绪：" + it.mood) }
    if has(x, ["中文" "华语" "国语"]) {
        it.lang = "zh"
        it.words.push("中文歌")
    }
    if has(x, ["英文" "欧美" "英语"]) {
        it.lang = "en"
        it.words.push("英文歌")
    }
    if has(x, ["换一批" "换一组" "换些" "别的" "没听过"]) {
        it.fresh = true
        it.words.push("换一批")
    }
    it
}

// ---- R 选曲：可解释的本地打分（PLAN 2.5）----
fn score_song(s, ctx, it){
    let sc = 0.0
    let why = []
    let a = act_by_id(ctx.activity.id)
    let target = 2.8
    if a != nil { target = a.target }
    target = target + it.energy
    if s.en != nil {
        let d = abs(s.en - target)
        sc = sc - d * 1.2
        if d <= 0.8 && a != nil { why.push("节奏" + energy_word(s.en) + "，合「" + a.n + "」") }
    } else { sc = sc - 0.9 }
    if s.vo != nil {
        if !s.vo {
            if it.instr == 1 {
                sc = sc + 2.0
                why.push("纯音乐")
            }
            if a != nil { sc = sc + a.instr }
            if it.instr == -1 { sc = sc - 2.5 }
        } else {
            if it.instr == 1 { sc = sc - 3.0 }
            if it.instr == -1 { sc = sc + 1.0 }
        }
    }
    if s.md != nil {
        if it.mood != "" && s.md == it.mood {
            sc = sc + 1.6
            why.push("情绪：" + s.md)
        }
        if a != nil && s.md == a.md { sc = sc + 0.6 }
        let wm = weather_mood()
        if wm != "" && s.md == wm {
            sc = sc + 0.5
            why.push(weather.text + "天配" + s.md)
        }
    }
    if it.lang != "" && s.lg != nil {
        if s.lg == it.lang { sc = sc + 1.0 } else { sc = sc - 1.5 }
    }
    let g = s.fb.g
    if a != nil {
        let ca = fb_get(s.fb, a.id)
        if ca > 0 {
            sc = sc + 1.4 * ca
            why.push("你在「" + a.n + "」时喜欢过")
        }
        if ca < 0 { sc = sc - 4.0 }
    }
    if g > 0 {
        sc = sc + 0.6 * g
        if why.len() < 2 { why.push("你喜欢过") }
    }
    if g < 0 { sc = sc - 1.5 }
    if it.fresh {
        for k in last_keys { if k == key_of(s) { sc = sc - 6.0 } }
    }
    sc = sc + random() * 0.35
    let text = join(why, " · ")
    if text == "" { text = "综合情境的折中选择" }
    {sc: sc why: text}
}

fn local_pick(ctx, it){
    let scored = []
    for i s in songs {
        let r = score_song(s, ctx, it)
        scored.push({i: i sc: r.sc why: r.why})
    }
    let out = []
    for n in 8 {
        let best = -1
        let bv = -1000000.0
        for j r in scored {
            if r.sc > bv {
                bv = r.sc
                best = j
            }
        }
        if best < 0 { break }
        out.push({i: scored[best].i why: scored[best].why})
        scored[best].sc = -1000000.0
    }
    out
}

// 一句话描述情境（界面状态行、历史、AI 输入共用）
fn ctx_text(ctx){
    let parts = []
    if prefs.use_time { parts.push(day_word(ctx) + ctx.slot) }
    if weather_usable() { parts.push(weather.text + " " + round(weather.temp) + "°C") }
    if ctx.motion.state != "unknown" { parts.push(motion_name(ctx.motion.state)) }
    if ctx.here.place != nil { parts.push("在" + ctx.here.place.name + "附近") }
    if ctx.activity.id != "" { parts.push(act_name(ctx.activity.id) + "（" + source_word(ctx.activity.source) + "）") }
    let text = join(parts, " · ")
    if text == "" { text = "无情境" }
    text
}

fn recommend(){ choose_requirement(ui.intent.text()) }
// 选歌看门狗：选歌途中处理函数被中断（慢盘上撞墙钟上限）或模型一直不回，
// busy 会一直为真、歌单一直隐藏、三步卡片全部点不动。超时后解锁并提示重试；
// rec_gen 让超时之后才到的模型回调直接作废，不会覆盖用户之后的操作。
let REC_TIMEOUT_S = 45
let rec_gen = 0
fn choose_requirement(raw){
    if busy || !booted { return }
    ui.intent.set_text(raw)
    flow_labels_before = nil
    rec_gen = rec_gen + 1
    let gen = rec_gen
    busy = true
    plan_note = "AI 正在理解情境并选歌…"
    ui.plan.set_text(plan_note)
    ui.list.set_visible(false)
    home_step(3)
    start_timeout(0.03, || recommend_run(raw, gen))
    start_timeout(REC_TIMEOUT_S, || rec_watch(gen))
}
fn rec_watch(gen){
    if gen != rec_gen || !busy { return }
    rec_gen = rec_gen + 1
    busy = false
    plan_note = "这次选歌没有完成（AI 没有响应或读写太慢），可以再试一次"
    ui.plan.set_text(plan_note)
    ui.list.set_visible(true)
    ui.list.render()
}
fn recommend_run(raw, gen){
    if gen != rec_gen { return }
    let it = parse_intent(raw)
    let ctx = build_ctx(it)
    if ctx.activity.source == "intent" {
        let top = []
        if last_rank != nil { for k in 3 { if k < last_rank.list.len() { top.push(last_rank.list[k].id) } } }
        add_label(cur_bucket(), ctx.activity.id, top, "intent")
    }
    if playlist.len() > 0 {
        last_keys = []
        for p in playlist { last_keys.push(key_of(songs[p.i])) }
    }
    if host.has("model") {
        busy = true
        plan_note = "AI 正在理解情境并选歌…"
        ui.plan.set_text(plan_note)
        ask_model(raw, it, ctx, gen)
    } else {
        finish(local_pick(ctx, it), "本地规则", raw, it, ctx, "")
    }
}

// AI 的输入：只发描述，不发坐标（PLAN 2.5）
fn signals_for_ai(ctx){
    let mt = "未知"
    if ctx.motion.state != "unknown" {
        mt = motion_name(ctx.motion.state) + " " + round(ctx.motion.speed * 10) / 10 + " m/s（" + ctx.motion.source + "，可信度 " + round(ctx.motion.conf * 100) / 100 + "）"
    }
    let wx = "未知"
    if weather_usable() { wx = weather.text + " " + round(weather.temp) + "°C" }
    let manual = ""
    if ctx.activity.source == "manual" { manual = ctx.activity.id }
    {time: day_word(ctx) + ctx.slot + " " + ctx.hour + "点" weather: wx motion: mt place: here_text()
        rule_activity: ctx.activity.id + "（" + source_word(ctx.activity.source) + "，可信度 " + round(ctx.activity.conf * 100) / 100 + "：" + join(ctx.activity.why, "；") + "）"
        manual: manual}
}
fn ask_model(raw, it, ctx, gen){
    let cands = []
    for i s in songs {
        let like = s.fb.g
        if ctx.activity.id != "" { like = like + fb_get(s.fb, ctx.activity.id) }
        cands.push({i: i title: s.t artist: s.a energy: s.en vocal: s.vo mood: s.md lang: s.lg like: like})
    }
    let n = songs.len() - 1
    host.request("model.complete", {
        task: "你是一个懂情境的音乐 DJ。第一步，判断用户此刻在做什么：signals 是传感器和规则给出的情境（manual 非空表示用户手动选定，必须照用），intent 是用户的原话；用户原话里说明的情境优先于传感器推断。rule_activity 后面括号里的可信度低于 0.5 时只是猜测（例如只凭时段），understood 里不要把它写成确定的事实，可以写“可能在…”。activity 从给定的 8 个值里选一个，判断不了就选 unknown，activity_why 用一句中文说明依据。第二步，从 songs 里挑 6 首按播放顺序排列：能量、是否人声、情绪要贴合你判断的活动和用户的意图；like 为正表示用户喜欢过，为负尽量不选；recent 是上一批，用户说换一批时避开。每首的 why 用不超过 30 字的中文说明它为什么适合此刻。understood 用一句话写你对用户意图的理解。只能从 songs 的 i 里选。"
        input: {signals: signals_for_ai(ctx) intent: raw recent: last_keys songs: cands}
        schema: {type: "object" required: ["understood" "activity" "activity_why" "picks"] additionalProperties: false
            properties: {understood: {type: "string" maxLength: 80}
                activity: {type: "string" enum: ["study" "work" "commute" "walk" "workout" "relax" "sleep" "unknown"]}
                activity_why: {type: "string" maxLength: 40}
                picks: {type: "array" minItems: 3 maxItems: 8
                    items: {type: "object" required: ["i" "why"] additionalProperties: false
                        properties: {i: {type: "integer" minimum: 0 maximum: n} why: {type: "string" maxLength: 40}}}}}}
        class: "fast"
    }, fn(r){ model_answer(r, raw, it, ctx, gen) })
}

fn model_answer(r, raw, it, ctx, gen){
    if gen != rec_gen { return }
    busy = false
    if !r.is_ok {
        finish(local_pick(ctx, it), "本地规则", raw, it, ctx, "AI 不可用：" + r.error)
        return
    }
    let o = pick(r.data, "output", nil)
    let picks = pick(o, "picks", [])
    let out = []
    let seen = []
    for p in picks {
        let i = pick(p, "i", -1)
        let ok_i = i >= 0 && i < songs.len()
        for x in seen { if x == i { ok_i = false } }
        if ok_i {
            out.push({i: i why: pick(p, "why", "")})
            seen.push(i)
        }
    }
    if out.len() < 3 {
        finish(local_pick(ctx, it), "本地规则", raw, it, ctx, "AI 返回的歌不足 3 首，改用本地规则")
        return
    }
    // PLAN 2.4：手动和原话里的明确情境优先；否则采用 AI 的判断
    let act = pick(o, "activity", "unknown")
    ai_raw = {activity: act activity_why: pick(o, "activity_why", "")}
    if ctx.activity.source != "manual" && ctx.activity.source != "intent" && act != "unknown" && act_by_id(act) != nil {
        ctx.activity = act_result(act, "ai", 0.85, ["AI：" + pick(o, "activity_why", "")])
    }
    finish(out, "AI", raw, it, ctx, "AI 理解：" + pick(o, "understood", ""))
}

let ai_raw = nil          // 最近一次 AI 返回的原始情境判断，写进历史，便于核对（G1 报告）
fn finish(picks, how, raw, it, ctx, note){
    busy = false
    ui.list.set_visible(true)
    playlist = picks
    playlist_act = ctx.activity.id
    playlist_slot = ctx.slot
    if ctx.activity.source == "intent" || ctx.activity.source == "ai" {
        session_act = {id: ctx.activity.id source: ctx.activity.source conf: ctx.activity.conf why: ctx.activity.why at: time_now() bucket: bucket_key(cur_bucket())}
    }
    last_ctx = ctx
    let summary = how + " · " + ctx_text(ctx)
    if note != "" { summary = summary + "\n" + note }
    if how != "AI" {
        if it.words.len() > 0 {
            summary = summary + "\n本地规则听懂了：" + join(it.words, "、")
        } else if ("" + raw).trim() != "" {
            summary = summary + "\n这句话本地规则没认出关键词，只按情境选"
        }
    }
    plan_note = summary
    playlist_intent = ("" + raw).trim()
    flow_activity = ctx.activity.id
    home_step(home_page)
    sync_home()
    refresh_views()
    // 写文件放到界面更新之后，每次读写各占一个处理函数：慢盘上一次写超时，只丢这一条记录，
    // 歌单照样显示出来（③-补2）。要用的值先取好，不依赖之后可能变化的全局变量
    let keys = []
    for p in picks { keys.push(key_of(songs[p.i])) }
    let air = ai_raw
    ai_raw = nil
    start_timeout(0.01, || save_last())
    start_timeout(0.02, || log_history(how, raw, ctx, keys, air))
    start_timeout(0.03, || enc_seen(ctx, picks))
}

// ---- 第一次相遇（DEMO-ILOVEU 4.2）----
// 一个时刻的情境快照：不存坐标，只存地点类型；天气不可用时为空；城市只在天气按城市查询时记
fn enc_moment(act, place_kind, mt){
    let p = local_parts()
    let wx = ""
    if weather_usable() { wx = weather.text + " " + round(weather.temp) + "°C" }
    let city = ""
    if weather.coords == "city" { city = CITIES[prefs.city].n }
    {at: time_now() slot: slot_name(p.hour) weekend: p.weekday == 0 || p.weekday == 6 act: act
        place_kind: place_kind motion: mt weather: wx city: city intent: playlist_intent sim: sim.kind != "off"}
}
fn enc_find(k){
    for j e in encounters { if e.k == k { return j } }
    -1
}
// 只记第一次，之后不再覆盖；唯一的例外：已有的是模拟记录，这次是真实的，就替换
fn enc_take(old, m){
    if old == nil { return true }
    if m.sim { return false }
    old.sim
}
// 返回这次有没有改动，调用方据此决定要不要写文件
fn enc_mark(k, which, m){
    let j = enc_find(k)
    if j < 0 {
        encounters.push({k: k seen: nil heard: nil liked: nil})
        j = encounters.len() - 1
    }
    let e = encounters[j]
    if which == "seen" && enc_take(e.seen, m) { e.seen = m return true }
    if which == "heard" && enc_take(e.heard, m) { e.heard = m return true }
    if which == "liked" && enc_take(e.liked, m) { e.liked = m return true }
    false
}
// 初见：歌单生成时，按生成这份歌单的情境记
fn enc_seen(ctx, picks){
    let pk = ""
    if ctx.here.place != nil { pk = ctx.here.place.kind }
    let m = enc_moment(ctx.activity.id, pk, ctx.motion.state)
    let changed = false
    for p in picks {
        if enc_mark(key_of(songs[p.i]), "seen", m) { changed = true }
    }
    if changed { save_encounters() }
}
// 初听、心动：按点下去那一刻的情境记；活动用歌单生成时的活动（和反馈一致）
fn enc_event(i, which){ enc_event_for(i, which, playlist_act) }
fn enc_event_for(i, which, event_act){
    if !booted { return }
    let pk = ""
    if here.place != nil { pk = here.place.kind }
    if enc_mark(key_of(songs[i]), which, enc_moment(event_act, pk, motion.state)) { save_encounters() }
}

// 历史不存坐标（PLAN 2.7）。读和写分在两个处理函数里
fn log_history(how, raw, ctx, keys, air){
    let h = read_json("history.json")
    if h == nil { h = [] }
    let pk = ""
    if ctx.here.place != nil { pk = ctx.here.place.kind }
    let next = [{at: time_now() how: how intent: raw ctx_text: ctx_text(ctx) act: ctx.activity.id act_source: ctx.activity.source
        motion: ctx.motion.state place_kind: pk sim: sim.kind != "off" picks: keys ai_raw: air}]
    for x in h { if next.len() < 30 { next.push(x) } }
    start_timeout(0.01, || write_json("history.json", next))
}

// ---- F 反馈：总体分 + 歌单生成时那个活动下的分 ----
fn feedback(i, v){
    let s = songs[i]
    let feedback_act = playlist_act
    if screen == "songcard" && sc_origin == "library" { feedback_act = "" }
    s.fb.g = clamp(s.fb.g + v, -3, 3)
    if feedback_act != "" { fb_set(s.fb, feedback_act, clamp(fb_get(s.fb, feedback_act) + v, -3, 3)) }
    save_feedback()
    // 第二次写文件放进单独的处理函数（③-补2）
    if v > 0 { start_timeout(0.01, || enc_event_for(i, "liked", feedback_act)) }
    let where = "总体"
    if feedback_act != "" { where = "「" + act_name(feedback_act) + "」和总体" }
    if v > 0 { ui.plan.set_text("记下了：在" + where + "里更常推荐《" + s.t + "》") }
    else { ui.plan.set_text("记下了：在" + where + "里少推《" + s.t + "》") }
    ui.list.render()
    ui.lib_list.render()
}

// ---- 曲库 ----
fn add_song(){
    let raw = ("" + ui.new_song.text()).trim()
    if raw == "" { return }
    let cut = raw.search(" - ")
    let t = raw
    let a = "未知歌手"
    if cut > 0 { t = raw.split(" - ")[0].trim() a = raw.split(" - ")[1].trim() }
    for s in songs {
        if s.t == t && s.a == a { ui.lib_status.set_text("曲库里已经有《" + t + "》") return }
    }
    songs.push({t: t a: a en: nil vo: nil md: nil lg: nil src: "user" fb: blank_fb()})
    index_songs()
    save_library()
    ui.new_song.set_text("")
    ui.lib_status.set_text("已添加《" + t + "》，还没有标签；点「AI 补标签」或直接用（按中性处理）")
    ui.lib_list.render()
}
fn remove_song(i){
    let s = songs[i]
    if s.src == "seed" { return }
    let kept = []
    for j x in songs { if j != i { kept.push(x) } }
    songs = kept
    index_songs()
    playlist = []
    save_library()
    save_feedback()
    ui.lib_status.set_text("已删除《" + s.t + "》")
    ui.lib_list.render()
}
fn untagged(){
    let out = []
    for i s in songs { if s.en == nil && out.len() < 30 { out.push({i: i title: s.t artist: s.a}) } }
    out
}
fn ai_tag(){
    let todo = untagged()
    if todo.len() == 0 { ui.lib_status.set_text("没有需要补标签的歌") return }
    if !host.has("model") { ui.lib_status.set_text("这台设备没有给本应用 AI 权限，无法补标签") return }
    ui.lib_status.set_text("AI 正在补 " + todo.len() + " 首歌的标签…")
    host.request("model.complete", {
        task: "为每首歌估计：energy 能量 1-5（1 最安静）、vocal 是否有人声、mood 从给定列表选一个、lang 语种（zh 中文、en 英文、instr 纯音乐、other 其他）。不认识的歌按歌名和歌手合理推断。"
        input: {moods: MOODS songs: todo}
        schema: {type: "object" required: ["tags"] additionalProperties: false
            properties: {tags: {type: "array" maxItems: 30
                items: {type: "object" required: ["i" "energy" "vocal" "mood" "lang"] additionalProperties: false
                    properties: {i: {type: "integer" minimum: 0} energy: {type: "integer" minimum: 1 maximum: 5}
                        vocal: {type: "boolean"} mood: {type: "string" enum: MOODS}
                        lang: {type: "string" enum: ["zh" "en" "instr" "other"]}}}}}}
        class: "fast"
    }, fn(r){ tag_answer(r) })
}
fn tag_answer(r){
    if !r.is_ok { ui.lib_status.set_text("AI 补标签失败：" + r.error) return }
    let n = 0
    for tg in r.data.output.tags {
        if tg.i >= 0 && tg.i < songs.len() && songs[tg.i].src == "user" {
            let s = songs[tg.i]
            s.en = tg.energy s.vo = tg.vocal s.md = tg.mood s.lg = tg.lang s.src = "user_ai"
            n = n + 1
        }
    }
    save_library()
    ui.lib_status.set_text("AI 补了 " + n + " 首的标签（标记为 AI 推断）")
    ui.lib_list.render()
}
fn fb_text(s){
    let parts = ""
    if s.fb.g > 0 { parts = "你喜欢过 +" + s.fb.g }
    if s.fb.g < 0 { parts = "你不太喜欢 " + s.fb.g }
    parts
}
fn energy_word(en){
    if en == 1 { return "安静" }
    if en == 2 { return "舒缓" }
    if en == 3 { return "适中" }
    if en == 4 { return "轻快" }
    if en == 5 { return "激烈" }
    "未标注"
}
fn tag_line(s){
    let v = "人声未标注"
    if s.vo != nil { v = if s.vo "人声" else "纯音乐" }
    let lang = "语种未标注"
    if s.lg == "zh" { lang = "中文" }
    if s.lg == "en" { lang = "英文" }
    if s.lg == "instr" { lang = "器乐" }
    if s.lg == "other" { lang = "其他语种" }
    s.a + " · " + energy_word(s.en) + " · " + v + " · " + lang
}

// ---- 情境控制 ----
fn set_act(id){
    if prefs.act == id && manual_left() > 0 {
        prefs.act = ""
        prefs.act_until = 0
    } else {
        prefs.act = id
        prefs.act_until = time_now() + ACT_TTL
    }
    save_prefs()
    refresh_views()
}
fn set_city(i){
    prefs.city = i
    save_prefs()
    ui.cities.render()
    if weather.coords != "gps" || fixes.len() == 0 { fetch_weather() }
}
fn toggle_weather(){
    prefs.use_weather = !prefs.use_weather
    save_prefs()
    refresh_views()
}
fn toggle_time(){
    prefs.use_time = !prefs.use_time
    save_prefs()
    refresh_views()
}
fn toggle_gps(){
    prefs.use_gps = !prefs.use_gps
    save_prefs()
    if !prefs.use_gps && sim.kind == "off" {
        fixes = []
        same_since = 0
        if weather.coords == "gps" { fetch_weather() }
    }
    gps_poll()
}

fn time_line(){
    let p = local_parts()
    let mm = "" + p.minute
    if p.minute < 10 { mm = "0" + mm }
    let tl = day_word(p) + slot_name(p.hour) + " " + p.hour + ":" + mm
    if weather.state != "ok" { tl = tl + "（按 UTC+8）" }
    if !prefs.use_time { tl = tl + " · 不参与" }
    tl
}
fn weather_line(){
    if weather.state == "loading" { return "加载中…" }
    if weather.state == "fail" { return "不可用（网络或服务出错）· 不参与" }
    let where = CITIES[prefs.city].n
    if weather.coords == "gps" { where = "当前位置" }
    if weather.coords == "gps" && sim.kind != "off" { where = "模拟位置" }
    let wl = where + " " + weather.text + " " + round(weather.temp) + "°C · Open-Meteo"
    if !prefs.use_weather { wl = wl + " · 不参与" }
    wl
}
fn motion_line(){
    if motion.state == "unknown" {
        if motion.note != "" { return motion.note }
        return "未知"
    }
    let src = "GPS"
    if motion.source == "sim" { src = "模拟" }
    motion_name(motion.state) + " · 约 " + round(motion.speed * 36) / 10 + " km/h · " + src + " · 可信度 " + round(motion.conf * 100) / 100
}
fn sync_context(){
    let c = build_ctx(nil)
    ui.ctx_time.set_text(time_line())
    ui.ctx_weather.set_text(weather_line())
    ui.ctx_motion.set_text(motion_line())
    ui.ctx_place.set_text(here_text())
    ui.ctx_act.set_text(act_line(c.activity))
    ui.ctx_why.set_text("依据：" + join(c.activity.why, "；"))
    ui.sim_banner.set_visible(sim.kind != "off")
    ui.cand_title.set_text(cand_title())
    ui.cands.render()
    ui.toggles.render()
}
fn fix_lines(){
    let out = []
    let now = time_now()
    let n = fixes.len()
    for k in 6 {
        let j = n - 1 - k
        if j >= 0 {
            let f = fixes[j]
            let line = round(now - f.t) + " 秒前 · 精度 ±" + round(f.acc) + " m"
            if j > 0 { line = line + " · 距上一点 " + round(dist_m(fixes[j - 1].lat, fixes[j - 1].lon, f.lat, f.lon)) + " m" }
            out.push(line)
        }
    }
    out
}
fn shown_places(){
    if sim.kind != "off" { return sim_places }
    places
}
fn sync_sense(){
    ui.sense_motion.set_text(motion_line())
    ui.sense_note.set_text(motion.note)
    ui.sense_here.set_text("地点：" + here_text())
    let lines = fix_lines()
    let t = join(lines, "\n")
    if t == "" { t = "还没有定位点。" + gps_note }
    ui.sense_fixes.set_text(t)
    ui.sense_banner.set_visible(sim.kind != "off")
    ui.sims.render()
    ui.kinds.render()
    ui.place_list.render()
}
fn refresh_views(){
    if screen == "home" { sync_context() }
    if screen == "sense" { sync_sense() }
}
fn sync_home(){
    ui.plan.set_text(plan_note)
    ui.list.render()
}

// ---- 歌曲卡：只读取本机文案和图片；反馈/初听沿用原有入口 ----
let song_cards = []
let card_history = []
let sc_history_gen = 0
let sc_pos = -1
let sc_queue = []
let sc_origin = "home"
let sc_page = 0
let sc_back = false
let sc_gen = 0
let sc_open_gen = 0
let sc_front_exists = false
let sc_user_exists = false
let sc_lyrics_exists = false
let sc_lyrics = ""
let sc_notice = ""
let sc_player_return = false

fn empty_song_card(){
    {k: "" facts: [] reading: "" by: "" credits: "" date: "" where: "" note: ""
        lyrics: "" front: "" user: "" demo: false}
}
fn load_song_card(row){
    let story = pick(row, "story", nil)
    let archive = pick(row, "archive", nil)
    let covers = pick(row, "covers", nil)
    let facts = []
    for f in pick(story, "facts", []) {
        let text = pick(f, "text", "")
        let src = pick(f, "src", "")
        let url = pick(f, "url", "")
        // 没有出处的条目不呈现为事实。
        if text != "" && src != "" && url != "" { facts.push({text: text src: src url: url}) }
    }
    let k = pick(row, "k", "")
    if k != "" {
        song_cards.push({k: k facts: facts reading: pick(story, "reading", "") by: pick(story, "by", "")
            credits: pick(archive, "credits", "") date: pick(archive, "date", "") where: pick(archive, "where", "") note: pick(archive, "note", "")
            lyrics: pick(row, "lyrics", "") front: pick(covers, "front", "") user: pick(covers, "user", "") demo: pick(row, "sim", false) == true})
    }
}
fn load_card_history(row){
    card_history.push({picks: pick(row, "picks", []) act: pick(row, "act", "") sim: pick(row, "sim", false) == true})
}
fn sc_read_history(){
    sc_history_gen = sc_history_gen + 1
    let gen = sc_history_gen
    let text = try { fs.read(DATA + "history.json") } { "" }
    let rows = as_list(text.parse_json())
    card_history = []
    start_timeout(0.01, || sc_history_chunk(gen, rows, 0))
}
fn sc_history_chunk(gen, rows, start){
    if gen != sc_history_gen { return }
    let end = min(start + 10, rows.len())
    for i in end - start { load_card_history(rows[start + i]) }
    if end < rows.len() { start_timeout(0.01, || sc_history_chunk(gen, rows, end)) }
    else if screen == "songcard" && sc_page == 3 { sc_render() }
}
fn sc_song(){ songs[sc_queue[sc_pos]] }
fn sc_data(){
    let k = key_of(sc_song())
    for c in song_cards { if c.k == k { return c } }
    empty_song_card()
}
fn sc_enc(){
    let j = enc_find(key_of(sc_song()))
    if j >= 0 { return encounters[j] }
    {seen: nil heard: nil liked: nil}
}
fn sc_is_demo(){
    if sc_data().demo || sim.kind != "off" { return true }
    let e = sc_enc()
    if e.seen != nil && e.seen.sim { return true }
    if e.heard != nil && e.heard.sim { return true }
    if e.liked != nil && e.liked.sim { return true }
    let k = key_of(sc_song())
    for row in card_history {
        if row.sim { for key in row.picks { if key == k { return true } } }
    }
    false
}
fn sc_context_line(){
    if sc_origin != "home" { return "" }
    if playlist_slot == "" || act_by_id(playlist_act) == nil { return "" }
    playlist_slot + act_name(playlist_act) + "时为你挑的"
}
fn sc_first_letter(){
    let chars = sc_song().t.split("")
    for ch in chars { if ch != "" { return ch } }
    "♪"
}
fn sc_photo(){
    sc_user_exists
}
fn sc_cover_path(){
    let c = sc_data()
    let path = c.front
    if sc_back { if sc_user_exists { return c.user } }
    else if sc_front_exists { return path }
    ""
}
fn sc_from_playlist(pos){
    sc_origin = "home"
    sc_queue = []
    for p in playlist { sc_queue.push(p.i) }
    sc_open(pos)
}
fn library_order(){
    let out = []
    for i s in songs { if s.src != "seed" { out.push(i) } }
    for i s in songs { if s.src == "seed" { out.push(i) } }
    out
}
fn sc_from_library(index){
    sc_origin = "library"
    sc_queue = library_order()
    for pos i in sc_queue { if i == index { sc_open(pos) return } }
}
fn sc_return(){
    show(sc_origin)
    if sc_origin == "home" { home_step(3) }
}
fn has_story(i){
    let k = key_of(songs[i])
    for c in song_cards { if c.k == k { return true } }
    false
}
fn song_title(i){ songs[i].t + if songs[i].fb.g > 0 " ♥" else "" }
fn sc_open(pos){
    if !booted || pos < 0 || pos >= sc_queue.len() { return }
    sc_pos = pos
    sc_page = 0
    sc_back = false
    sc_open_gen = sc_open_gen + 1
    sc_front_exists = false
    sc_user_exists = false
    sc_lyrics_exists = false
    sc_lyrics = ""
    sc_notice = ""
    show("songcard")
    sc_render()
    let gen = sc_open_gen
    // 三次存在性检查各占一个处理函数；渲染只用缓存。
    start_timeout(0.01, || sc_check_front(gen))
    start_timeout(0.02, || sc_check_user(gen))
    start_timeout(0.03, || sc_check_lyrics(gen))
    start_timeout(0.04, || sc_read_history())
}
fn sc_check_front(gen){
    if gen != sc_open_gen || screen != "songcard" { return }
    let path = sc_data().front
    sc_front_exists = path != "" && fs.exists(path)
    if sc_page == 0 { sc_render() }
}
fn sc_check_user(gen){
    if gen != sc_open_gen || screen != "songcard" { return }
    let path = sc_data().user
    sc_user_exists = path != "" && fs.exists(path)
    ui.sc_flip_label.set_text(if sc_user_exists "轻点翻面" else "")
}
fn sc_check_lyrics(gen){
    if gen != sc_open_gen || screen != "songcard" { return }
    let path = sc_data().lyrics
    sc_lyrics_exists = path != "" && fs.exists(path)
    if sc_lyrics_exists { start_timeout(0.01, || sc_read_lyrics(gen)) }
}
fn sc_read_lyrics(gen){
    if gen != sc_open_gen || screen != "songcard" { return }
    let path = sc_data().lyrics
    if path == "" { return }
    sc_lyrics = try { fs.read(path) } { "" }
    if sc_page == 1 { ui.sc_content.render() }
}
fn sc_load_image(gen, path){
    if gen != sc_gen || screen != "songcard" || sc_page != 0 { return }
    if path == "" { return }
    let bytes = try { fs.read_bytes(path) } { [] }
    if bytes.len() == 0 {
        if sc_back { sc_user_exists = false sc_back = false }
        else { sc_front_exists = false }
        sc_render()
        return
    }
    if bytes.len() > 300000 {
        ui.sc_picture.set_visible(false)
        ui.sc_disc.set_visible(true)
        ui.sc_notice.set_text("图片超过 300 KB，请压缩后重新打开歌曲卡")
        return
    }
    ui.sc_image.load_image_from_data_async(bytes)
}
fn sc_render(){
    if sc_pos < 0 || sc_pos >= sc_queue.len() { return }
    sc_gen = sc_gen + 1
    ui.sc_heading.set_text(sc_song().t + " · " + sc_song().a)
    ui.sc_demo.set_visible(sc_is_demo())
    ui.sc_front.set_visible(sc_page == 0)
    ui.sc_content.set_visible(sc_page != 0)
    if sc_page != 0 { ui.sc_content.render() }
    ui.sc_title.set_text(sc_song().t)
    ui.sc_artist.set_text(sc_song().a)
    let context = sc_context_line()
    ui.sc_context.set_text(context)
    ui.sc_context.set_visible(context != "")
    ui.sc_letter.set_text(sc_first_letter())
    let cover = sc_cover_path()
    ui.sc_image.set_src(nil)
    ui.sc_picture.set_visible(cover != "")
    ui.sc_disc.set_visible(cover == "")
    ui.sc_cover_label.set_text(if sc_back "" else if cover == "" "暂无封面" else "官方封面")
    ui.sc_flip_label.set_text(if sc_back "你的照片" else if sc_photo() "轻点翻面" else "")
    ui.sc_dots.render()
    ui.sc_count.set_text("第 " + (sc_pos + 1) + " 首，共 " + sc_queue.len() + " 首")
    ui.sc_notice.set_text(sc_notice)
    if sc_page == 0 {
        let gen = sc_gen
        let path = sc_cover_path()
        if path != "" { start_timeout(0.01, || sc_load_image(gen, path)) }
    }
}
fn sc_turn(page){
    let next = clamp(page, 0, 3)
    if next == sc_page { return }
    sc_page = next
    sc_render()
}
fn sc_swipe(dx, dy){
    if dx < 0 { sc_turn(sc_page + 1) }
    if dx > 0 { sc_turn(sc_page - 1) }
}
fn sc_flip(){
    if !sc_photo() { return }
    sc_back = !sc_back
    sc_render()
}
fn sc_next(delta){
    if sc_queue.len() == 0 { return }
    sc_open((sc_pos + delta + sc_queue.len()) % sc_queue.len())
}
fn sc_feedback(v){
    if !booted { return }
    let i = sc_queue[sc_pos]
    feedback(i, v)
    if v < 0 { sc_next(1) }
    else {
        sc_notice = "已记下喜欢"
        ui.sc_notice.set_text(sc_notice)
        start_timeout(0.05, || sc_refresh_enc())
    }
}
fn sc_refresh_enc(){
    if screen == "songcard" { sc_render() }
}
fn sc_play(){
    sc_player_return = true
    play(sc_queue[sc_pos])
}
fn sc_local_time(at){
    // card-host 默认 UTC，其他宿主可能已设本地偏移；消除该偏移后统一显示 UTC+8。
    let origin = local_time(0)
    let offset = origin.hour * 3600 + origin.minute * 60 + origin.second
    if origin.year < 1970 { offset = offset - 86400 }
    local_time(at + 28800 - offset)
}
fn sc_date(m){
    if m == nil || m.at <= 0 { return "尚未记录" }
    let p = sc_local_time(m.at)
    "" + p.year + "." + p.month + "." + p.day
}
fn sc_moment_text(m, title){
    if m == nil { return "还没有" + title + "记录" }
    let out = []
    if m.slot != "" { out.push(m.slot) }
    if m.act != "" { out.push(act_name(m.act)) }
    if m.place_kind != "" { out.push(kind_name(m.place_kind)) }
    if m.weather != "" { out.push(m.weather) }
    if m.city != "" { out.push(m.city) }
    let text = join(out, " · ")
    if m.intent != "" { text = text + "\n你说：" + m.intent }

    text
}
fn sc_stats(){
    let k = key_of(sc_song())
    let count = 0
    let demo = false
    for row in card_history {
        for key in row.picks { if key == k { count = count + 1 if row.sim { demo = true } } }
    }
    let text = "最近 " + card_history.len() + " 条历史中推荐 " + count + " 次"
    if demo { text = text + "（含测试数据）" }
    let top = []
    let top_count = 0
    for a in ACTS {
        let n = 0
        for row in card_history {
            if row.act == a.id { for key in row.picks { if key == k { n = n + 1 } } }
        }
        if n > top_count { top_count = n top = [] }
        if n == top_count && n > 0 { top.push(a.n) }
    }
    if top.len() > 0 {
        text = text + "\n这些记录中最常在：" + join(top, "、")
        if top.len() > 1 { text = text + "（并列）" }
    }
    let e = sc_enc()
    if e.seen != nil && e.seen.at > 0 {
        text = text + "\n距初见 " + max(0, floor((time_now() - e.seen.at) / 86400)) + " 天"
    }
    text + "\n历史最多保留 30 条，不代表累计播放次数"
}
fn sc_lyric_lines(){
    let out = []
    for line in sc_lyrics.split("\n") {
        let text = line.trim()
        if text.search("[ti:") != 0 && text.search("[ar:") != 0 && text.search("[al:") != 0 && text.search("[au:") != 0 && text.search("[by:") != 0 && text.search("[offset:") != 0 {
            if text.search("[") == 0 && text.search("]") > 0 {
                let parts = text.split("]")
                text = parts[parts.len() - 1]
            }
            if text != "" { out.push(text) }
        }
    }
    out
}

// ---- 三步卡片；切换不读取文件、不启动天气或定位 ----
let REQUIREMENTS = ["甜一点" "安静一点" "带劲一点" "不要人声" "只听中文" "来点没听过的"]
let home_page = 1
let context_expanded = false
fn flow_summary(){
    let text = act_name(flow_activity)
    if flow_activity == "" { text = "按情境推断" }
    if here.place != nil { text = text + " · " + here.place.name }
    if weather_usable() { text = text + " · " + weather.text + " " + round(weather.temp) + "°C" }
    text
}
fn home_step(page){
    home_page = page
    ui.step1.set_visible(page == 1)
    ui.step2.set_visible(page == 2)
    ui.step3.set_visible(page == 3)
    ui.home_back.set_visible(page > 1)
    ui.home_dots.render()
    ui.activity_chip.set_text(flow_summary())
    ui.play_activity.set_text(flow_summary())
    let raw = ui.intent.text().trim()
    ui.play_intent.set_text(if raw == "" "没有额外要求" else raw)
}
fn flow_restart(){
    if busy { return }
    flow_labels_before = nil
    flow_activity = ""
    ui.intent.set_text("")
    home_step(1)
}
fn toggle_context(){
    context_expanded = !context_expanded
    ui.context_edit.set_visible(context_expanded)
}
// ---- 页面切换与播放 ----
fn show(name){
    screen = name
    ui.home.set_visible(name == "home")
    ui.sense.set_visible(name == "sense")
    ui.library.set_visible(name == "library")
    ui.player_pane.set_visible(name == "player")
    ui.song_card.set_visible(name == "songcard")
    if name == "home" {
        home_step(home_page)
        sync_context()
        sync_home()
    }
    if name == "sense" { sync_sense() }
    if name == "library" { ui.lib_list.render() }
}
fn play(i){
    let event_act = playlist_act
    if screen == "songcard" && sc_origin == "library" { event_act = "" }
    start_timeout(0.01, || enc_event_for(i, "heard", event_act))
    playing = songs[i]
    ui.player_title.set_text(playing.t + " — " + playing.a)
    ui.player_fail.set_text("")
    show("player")
    open_source()
}
fn open_source(){
    if playing == nil { return }
    ui.sources.render()
    let q = (playing.t + " " + playing.a).url_encode()
    let url = SOURCES[source].url + q
    ui.player_url.set_text("在 " + SOURCES[source].n + " 搜索：" + playing.t + " " + playing.a + "\n" + url)
    let ok_open = ui.reader.open(url)
    if !ok_open { ui.player_fail.set_text("打不开这个页面：这台设备可能没给本应用打开网页的权限") }
}
fn pick_source(i){
    source = i
    open_source()
}
fn close_player(){
    ui.reader.close()
    playing = nil
    if sc_player_return && sc_pos >= 0 && sc_pos < sc_queue.len() {
        sc_player_return = false
        show("songcard")
        sc_render()
    } else { show("home") }
}

fn boot(){
    plan_note = "正在加载…"
    sync_home()
    boot_next("dir")
}
start_timeout(0.05, || boot())
// 启动看门狗：boot() 本身超时也能接住（boot_step 初值是 "dir"）
start_interval(BOOT_STALL_S, || boot_watch())
start_interval(GPS_POLL_S, || gps_poll())

// ---- 外观 ----
let ground = SC_GROUND
let card = SC_CARD
let raised = SC_RAISED
let ink = SC_INK
let secondary = SC_MUTED
let accent = SC_ACCENT
let good = SC_INK
let bad = SC_INK

let Chip = ButtonFlat{height: 44 padding: Inset{left: 12 right: 12}
    draw_bg +: {border_radius: 16.0 color: raised color_hover: SC_BORDER color_down: SC_BORDER border_size: 0.0}
    draw_text +: {color: ink color_hover: ink color_down: ink text_style +: {font_size: 13}}
}
let ChipOn = Chip{
    draw_bg +: {color: accent color_hover: SC_ACCENT color_down: SC_ACCENT}
    draw_text +: {color: SC_GROUND color_hover: SC_GROUND color_down: SC_GROUND}
}
let Small = ButtonFlat{height: 44 padding: Inset{left: 10 right: 10}
    draw_bg +: {border_radius: 22.0 color: raised color_hover: SC_BORDER color_down: SC_BORDER border_size: 0.0}
    draw_text +: {color: ink color_hover: ink color_down: ink text_style +: {font_size: 12}}
}
let Primary = ButtonFlat{height: 44 padding: Inset{left: 18 right: 18}
    draw_bg +: {border_radius: 22.0 color: accent color_hover: SC_ACCENT color_down: SC_ACCENT border_size: 0.0}
    draw_text +: {color: SC_GROUND color_hover: SC_GROUND color_down: SC_GROUND text_style +: {font_size: 14}}
}
let Bar = ButtonFlat{height: 44 padding: Inset{left: 10 right: 10}
    draw_bg +: {color: SC_CLEAR color_hover: SC_RAISED color_down: SC_BORDER border_size: 0.0}
    draw_text +: {color: accent color_hover: accent color_down: accent text_style +: {font_size: 14}}
}
let Field = TextInput{width: Fill height: 44
    draw_bg +: {color: raised color_hover: raised color_focus: raised color_empty: raised border_radius: 10.0}
    draw_text +: {color: ink color_hover: ink color_focus: ink color_empty: secondary color_empty_hover: secondary}
}


let ScText = Label{draw_text.color: SC_INK draw_text.text_style.font_size: 14}
let ScMuted = Label{draw_text.color: SC_MUTED draw_text.text_style.font_size: 12}
let ScTitle = Label{width: Fill draw_text.color: SC_INK draw_text.text_style: theme.font_bold{font_size: 22}}
let ScButton = ButtonFlat{height: 44 padding: 4
    draw_bg +: {border_radius: 28.0 border_size: 0.0 color: SC_CARD color_hover: SC_RAISED color_down: SC_BORDER}
    draw_text +: {color: SC_MUTED color_hover: SC_INK color_down: SC_INK text_style +: {font_size: 12}}
}
let ScPrimary = ScButton{
    draw_bg +: {color: SC_ACCENT color_hover: SC_ACCENT color_down: SC_ACCENT}
    draw_text +: {color: SC_GROUND color_hover: SC_GROUND color_down: SC_GROUND text_style +: {font_size: 14}}
}

let Notice = RoundedView{width: Fill height: Fit flow: Down padding: 8 draw_bg.color: SC_WARNING_BG draw_bg.border_radius: 16.0}
let Activity = Chip{width: Fill height: 52 draw_bg.border_radius: 16.0 draw_text.text_style.font_size: 14}
let ActivityTop = Activity{draw_bg +: {border_size: 1.0 border_color: SC_ACCENT}}

SolidView{width: Fill height: Fill flow: Overlay draw_bg.color: ground
    home := SolidView{width: Fill height: Fill flow: Down spacing: 12 padding: 16 draw_bg.color: SC_GROUND
        View{width: Fill height: 52 flow: Right spacing: 8 align: Align{y: 0.5}
            home_back := Bar{visible: false width: 44 text: "‹" on_click: || home_step(home_page - 1)}
            Label{width: Fill text: "情境 DJ" draw_text.color: SC_INK draw_text.text_style: theme.font_bold{font_size: 24}}
            Bar{text: "感知" on_click: || show("sense")}
            Bar{text: "曲库" on_click: || show("library")}
        }
        home_dots := View{width: Fill height: 24 flow: Right spacing: 8 align: Align{x: 0.5 y: 0.5} on_render: || {
            for n in 3 { RoundedView{width: if n + 1 == home_page 20 else 8 height: 8 draw_bg.color: if n + 1 == home_page SC_ACCENT else SC_BORDER draw_bg.border_radius: 4.0} }
        }}
        sim_banner := Notice{visible: false ScMuted{width: Fill text: "模拟定位中：移动和地点来自模拟数据" draw_text.color: SC_WARNING}}
        step1 := ScrollYView{width: Fill height: Fill flow: Down spacing: 14
            ScTitle{text: "① 你在做什么"}
            RoundedView{width: Fill height: Fit flow: Down padding: 16 spacing: 6 draw_bg.color: SC_CARD draw_bg.border_radius: 24.0
                Bar{width: Fill text: "改情境 ›" on_click: || toggle_context()}
                ctx_time := ScMuted{width: Fill text: ""}
                ctx_weather := ScMuted{width: Fill text: ""}
                ctx_motion := ScMuted{width: Fill text: ""}
                ctx_place := ScMuted{width: Fill text: ""}
                context_edit := View{visible: false width: Fill height: Fit flow: Down spacing: 8
                    toggles := View{width: Fill height: 50 flow: Right spacing: 6 on_render: || {
                        if prefs.use_gps { ChipOn{text: "用定位" on_click: || toggle_gps()} } else { Chip{text: "用定位" on_click: || toggle_gps()} }
                        if prefs.use_time { ChipOn{text: "用时段" on_click: || toggle_time()} } else { Chip{text: "用时段" on_click: || toggle_time()} }
                        if prefs.use_weather { ChipOn{text: "用天气" on_click: || toggle_weather()} } else { Chip{text: "用天气" on_click: || toggle_weather()} }
                    }}
                    cities := ScrollXView{width: Fill height: 50 flow: Right spacing: 6 on_render: || {
                        for i c in CITIES {
                            if prefs.city == i { ChipOn{text: c.n on_click: || set_city(i)} } else { Chip{text: c.n on_click: || set_city(i)} }
                        }
                    }}
                }
            }
            ScText{width: Fill text: "你现在在做什么？"}
            ctx_act := ScMuted{width: Fill text: ""}
            cand_title := ScMuted{width: Fill text: ""}
            cands := View{width: Fill height: Fit flow: Down spacing: 8 on_render: || {
                for r in 4 {
                    View{width: Fill height: 52 flow: Right spacing: 8
                        for col in 2 {
                            let j = r * 2 + col
                            if j < ACTS.len() {
                                let a = ACTS[j]
                                if prefs.act == a.id && manual_left() > 0 {
                                    Activity{ text: a.n draw_bg.color: SC_ACCENT draw_bg.color_hover: SC_ACCENT draw_bg.color_down: SC_ACCENT draw_text.color: SC_GROUND draw_text.color_hover: SC_GROUND draw_text.color_down: SC_GROUND on_click: || confirm_act(a.id, "tap") }
                                } else if last_rank != nil && last_rank.list[0].id == a.id {
                                    ActivityTop{text: a.n on_click: || confirm_act(a.id, "tap")}
                                } else { Activity{text: a.n on_click: || confirm_act(a.id, "tap")} }
